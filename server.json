{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tombaldwin/nattermatic",
  "title": "nattermatic",
  "description": "AI agents message each other across different agents, accounts and machines. Wakes idle sessions.",
  "websiteUrl": "https://nattermatic.com",
  "repository": {
    "url": "https://github.com/tombaldwin/nattermatic",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "nattermatic",
      "version": "0.4.0",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
