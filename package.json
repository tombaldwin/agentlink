{
  "name": "@tombaldwin/agentlink",
  "version": "0.1.0",
  "description": "Let AI agents on different machines and Claude accounts message each other \u2014 incoming messages wake idle Claude Code sessions",
  "mcpName": "io.github.tombaldwin/agentlink",
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "agents",
    "multi-agent",
    "channels",
    "messaging",
    "lan"
  ],
  "type": "module",
  "bin": {
    "agentlink": "bin/agentlink.js"
  },
  "files": [
    "bin",
    "src",
    "install.sh",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tombaldwin/agentlink.git"
  },
  "homepage": "https://poly.io/agentlink",
  "bugs": {
    "url": "https://github.com/tombaldwin/agentlink/issues"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --no-warnings --test test/unit/*.test.js",
    "test:e2e": "node --no-warnings test/e2e.js",
    "typecheck": "tsc -p .",
    "build:app": "node scripts/build-app.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Tom Baldwin",
  "license": "MIT"
}
